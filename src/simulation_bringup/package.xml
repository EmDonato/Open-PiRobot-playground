<?xml version="1.0"?>
<package format="3">
  <name>simulation_bringup</name><version>0.1.0</version>
  <description>Robot-specific Gazebo house simulation</description>
  <maintainer email="mcf.donato@gmail.com">Emanuele Donato</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>xacro</exec_depend><exec_depend>robot_descriptor</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend><exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>robot_interfaces</exec_depend>
  <exec_depend>joy</exec_depend><exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
